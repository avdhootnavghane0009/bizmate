# Server Configuration
PORT=5001
NODE_ENV=development
PROJECT_NAME="Bizmate"
API_V1_STR="/api/v1"
SECRET_KEY="your_production_super_secret_jwt_key_min_32_characters"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizmate"
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"

# Meta WhatsApp Cloud API (v21.0)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_VERIFY_TOKEN=bizmate_webhook_verify_token_secure
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION="v21.0"

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY="INR"

# AES-256-GCM Token Encryption (32-byte key or falls back to SECRET_KEY)
ENCRYPTION_KEY=

# n8n Automation Engine
N8N_WEBHOOK_BASE_URL="http://localhost:5678/webhook"
N8N_WORKFLOW_KEY="bizmate_n8n_secret_auth_token_key"

# Cloudflare R2 / AWS S3 Storage (Optional: defaults to local disk)
MEDIA_UPLOAD_DIR="media/voice_notes"
MOCK_MODE_IF_NO_CREDENTIALS=true
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
